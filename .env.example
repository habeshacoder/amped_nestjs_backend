# Application Environment & Server Config
NODE_ENV=development
PORT=3007

# Database Connection (PostgreSQL Prisma connection string)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/amped_db?schema=public

# JWT Authentication Secrets
JWT_SECRET=your_jwt_access_secret_key_min_16_characters
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_min_16_characters

# Chapa Payment Integration
CHAPA_SECRET_KEY=CHASECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CHAPA_WEBHOOK_HASH_KEY=your_chapa_webhook_hash_secret
CHAPA_WEBHOOK_URL=https://api.example.com/channel-purchase/webhook
