# Application Environment & Server Config
NODE_ENV=development
PORT=3007

# Database Connection (PostgreSQL Prisma connection string with pool settings)
# Example with connection pooling: ?schema=public&connection_limit=10&pool_timeout=30
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/amped_db?schema=public&connection_limit=10&pool_timeout=30
# Shadow Database for Prisma Migrate schema drift checks
SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/amped_db_shadow?schema=public

# JWT Authentication Secrets
JWT_SECRET=your_jwt_access_secret_key_min_16_characters
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_min_16_characters

# Chapa Payment Integration
CHAPA_SECRET_KEY=CHASECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CHAPA_WEBHOOK_HASH_KEY=your_chapa_webhook_hash_secret
CHAPA_WEBHOOK_URL=https://api.example.com/channel-purchase/webhook

# Sentry Observability (Optional)
SENTRY_DSN=

# Security & Rate Limiting
# Allowed CORS origins, comma-separated or * for wildcard
CORS_ORIGIN=*
# Throttler window in milliseconds
THROTTLE_TTL=60000
# Throttler request limit per window
THROTTLE_LIMIT=100
