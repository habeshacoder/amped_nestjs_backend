{
  "name": "amped_backend",
  "version": "1.3.0",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@10.8.2",
  "scripts": {
    "deploy": "vercel",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:dev:deploy": "prisma migrate deploy",
    "prisma:test:deploye": "dotenv -e .env.test -- prisma migrate deploy",
    "migration:run": "prisma migrate deploy",
    "migration:status": "prisma migrate status",
    "migration:generate": "prisma migrate dev --create-only",
    "migration:check": "prisma migrate diff --from-migrations ./prisma/migrations --to-schema-datamodel ./prisma/schema.prisma --exit-code",
    "db:dev:restart": "prisma migrate reset -s -f -v",
    "db:test:restart": "dotenv -e .env.test -- prisma migrate reset -f",
    "prebuild": "rimraf dist && prisma generate",
    "build": "nest build",
    "copy-package": "cp package.json dist/package.json",
    "copy-prisma-schema": "cp ./prisma/schema.prisma dist/schema.prisma",
    "build-with-package": "npm run build && npm run copy-package && npm run copy-prisma-schema",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "test": "jest --coverage",
    "test:unit": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:e2e:local": "docker compose -f docker-compose.test.yml up -d postgres-test && npm run test:e2e",
    "test:e2e:local:down": "docker compose -f docker-compose.test.yml down -v",
    "test:e2e:watch": "dotenv -e .env.test -- jest --watch --no-cache --config ./test/jest-e2e.json",
    "dup": "jscpd src --min-lines 15 --threshold 10",
    "verify": "npx prisma generate && npm run build && npm test",
    "prepare": "husky"
  },
  "overrides": {
    "chapa-nestjs": {
      "@nestjs/common": "$@nestjs/common",
      "@nestjs/axios": "^3.0.0"
    },
    "deepmerge-ts": "^8.0.2",
    "tar": "^7.5.22",
    "smol-toml": "^1.9.0",
    "undici": "^6.27.1",
    "tmp": "^0.2.7",
    "serialize-javascript": "^7.1.2",
    "picomatch": "^4.0.4",
    "webpack": "^5.105.0",
    "js-yaml": "^4.1.0",
    "multer": "^1.4.5-lts.1",
    "body-parser": "^1.20.6",
    "lodash": "^4.18.1"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/swagger": "^7.4.0",
    "@nestjs/terminus": "^10.2.3",
    "@nestjs/throttler": "^6.7.0",
    "@prisma/client": "6.19.3",
    "@sentry/node": "^10.75.0",
    "argon2": "0.45.1",
    "chapa-nestjs": "^1.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "google-auth-library": "^11.1.0",
    "helmet": "^8.3.0",
    "joi": "^18.2.9",
    "nestjs-pino": "^4.6.1",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@nestjs/cli": "^10.4.0",
    "@nestjs/schematics": "^10.2.0",
    "@nestjs/testing": "^10.4.0",
    "@types/express": "^4.17.13",
    "@types/jest": "^29.5.14",
    "@types/joi": "^17.2.2",
    "@types/multer": "^1.4.7",
    "@types/node": "^16.0.0",
    "@types/passport-jwt": "^3.0.8",
    "@types/supertest": "^2.0.11",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "dotenv-cli": "^6.0.0",
    "eslint": "^8.0.1",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^4.0.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jscpd": "^5.3.0",
    "lint-staged": "^16.4.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^2.3.2",
    "prisma": "6.19.3",
    "prisma-dbml-generator": "^0.12.0",
    "rimraf": "^6.1.3",
    "supertest": "^6.1.3",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.0.0",
    "tsconfig-paths": "4.1.0",
    "typescript": "^5.9.3",
    "vercel": "^59.23.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "testPathIgnorePatterns": [
      ".*\\.integration\\.spec\\.ts$"
    ],
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!main.ts",
      "!**/*.module.ts",
      "!**/*.dto.ts",
      "!**/*.entity.ts",
      "!**/migrations/**",
      "!**/index.ts",
      "!**/*.spec.ts"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1"
    },
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    }
  }
}
